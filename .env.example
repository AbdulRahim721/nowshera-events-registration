# Keep this file as an example. Copy it to .env and fill your own values.

# Local default:
DATABASE_URL=sqlite:///./data/app.db

# Supabase PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.tvwmokxxznetdlnixkeh.supabase.co:5432/postgres

# Used to sign login tokens. Change this for production.
APP_SECRET=change-this-long-random-secret

# Optional, for documentation/frontend reference.
SUPABASE_URL=https://tvwmokxxznetdlnixkeh.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Used by the local server to sync signup/login/registrations to the deployed
# Supabase Edge Function. Keep your real key in .env only.
SUPABASE_SYNC_KEY=YOUR_PRIVATE_SYNC_KEY
SUPABASE_SYNC_FUNCTION_URL=https://tvwmokxxznetdlnixkeh.functions.supabase.co/nowshera-sync
